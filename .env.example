DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# --- Production (Railway / Docker) — required for HTTPS form POSTs ---
# DJANGO_SETTINGS_MODULE=config.settings.production
# DEBUG=False
# ALLOWED_HOSTS=fileforge.asteriq.in,.railway.app
# CSRF_TRUSTED_ORIGINS=https://fileforge.asteriq.in
SITE_NAME=FileForge
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///db.sqlite3
# Private storage — empty MEDIA_URL means no direct /media/ serving.
# MEDIA_ROOT=/var/fileforge/media
# MEDIA_URL=
CONVERSION_MAX_UPLOAD_MB=100
CONVERSION_JOB_TTL_HOURS=24
CONVERSION_MAX_BATCH_FILES=10
CONVERSION_MAX_BATCH_MB=100
CONVERSION_MAX_PDF_PAGES=200
CONVERSION_MAX_IMAGE_PIXELS=40000000
# 0 = signed download token lives until job expires_at.
CONVERSION_DOWNLOAD_TOKEN_MAX_AGE_SEC=0
# Convert POSTs per IP within CONVERSION_RATE_WINDOW_SEC (0 disables).
CONVERSION_RATE_LIMIT=20
CONVERSION_RATE_WINDOW_SEC=3600
# Optional Redis cache. Uncomment when `npm run redis:up` / Docker Redis is running.
# CACHE_URL=redis://127.0.0.1:6379/1
# Only trust X-Forwarded-For behind a reverse proxy.
USE_X_FORWARDED_FOR=False
# Optional malware scan. Not installed locally — Docker image includes clamav.
CLAMAV_ENABLED=False
# CLAMAV_BINARY=clamscan
# CLAMAV_TIMEOUT_SEC=30
# True = convert inside the web request (simple local). False = Celery worker.
CONVERSION_SYNC_ENABLED=True
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
